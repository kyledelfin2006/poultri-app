{
  "expo": {
    "name": "Poultri",
    "slug": "poultri",
    "scheme": "poultri",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/poultri-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to the Poultri desktop farm simulator on your local Wi-Fi network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.poultri.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/poultri-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      ["expo-notifications", { "icon": "./assets/android-icon-monochrome.png", "color": "#155B36" }],
      ["expo-build-properties", { "android": { "buildArchs": ["arm64-v8a"], "usesCleartextTraffic": true } }]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3f8cad76-4690-4a37-a65d-a4b1563beec9"
      }
    },
    "owner": "kylehatestheworld"
  }
}
